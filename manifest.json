{
  "display_information": {
    "name": "Link Bookmarks",
    "description": "Save and organize links from Slack messages",
    "long_description": "Link Bookmarks lets you save links from any Slack message into a personal collection. Browse, search, and share your saved links without leaving Slack. Add it to any channel and type \"hello bot\" or use the slash command `/save-link` to save your first bookmark",
    "background_color": "#4A154B"
  },
  "features": {
    "bot_user": {
      "display_name": "Link Bookmarks",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true
    },
    "slash_commands": [
      {
        "command": "/save-link",
        "description": "Save a link to your bookmarks",
        "usage_hint": "<url>"
      },
      {
        "command": "/show-links",
        "description": "Search and display your saved links",
        "usage_hint": "[keyword]"
      },
      {
        "command": "/delete-links",
        "description": "Select and delete saved links"
      }
    ],
    "shortcuts": [
       {
        "name": "Show Saved Links",
        "type": "global",
        "callback_id": "show_saved_links",
        "description": "Show what links you've saved"
      },
      {
        "name": "Add Links",
        "type": "global",
        "callback_id": "add_links",
        "description": "Add several links at once"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "chat:write", "commands", "channels:history", "reactions:write"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.channels", "app_home_opened"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true
  }
}
